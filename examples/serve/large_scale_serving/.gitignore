# Generated performance reports: perf_report.py writes REPORT.html plus the
# per-request, per-session and per-iteration CSVs here (REPORTS_ROOT), and
# build_index.py adds index.html. Iteration-grain files run to tens of MB even
# gzipped, so they stay out of the tree's history.
_reports/
_reports_pending/

# Per-instance deployment YAMLs that fleetctl derives from fleet.yaml. They are
# output, not input: fleetctl rewrites them on every `up` and `roll`, and a
# stale committed copy would silently outrank the fleet file it came from.
generated/
__pycache__/

# Checkpoint index over the engine logs, written beside the attempt it
# describes. Derived from the logs and rebuilt if it goes missing.
.engine_index/

# Everything the running deployment writes: fleet.yaml points trace.root here,
# so it holds the run directories, the engine logs, the perf metrics, the
# sbatch logs, the fleet registrations and the gateway's own state. Runtime
# output rather than source, and large with it -- the engine logs alone reach
# about 150 GB per instance over the seven days a job may live.
var/
